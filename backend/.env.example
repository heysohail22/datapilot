# Use a dedicated PostgreSQL role with SELECT only on the business allowlist.
DATABASE_URL=postgresql://datapilot_reader:replace_me@localhost:5432/datapilot
LLM_PROVIDER=groq
LLM_API_KEY=
# Existing provider-specific key names also work as fallbacks.
GROQ_API_KEY=
GEMINI_API_KEY=
ROUTER_MODEL=openai/gpt-oss-120b
SQL_MODEL=openai/gpt-oss-120b
ANSWER_MODEL=openai/gpt-oss-120b
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_CURRENCY=INR
BUSINESS_TABLES=customers,orders,order_items,products,categories,payments
# Start disabled. Map each enabled metric to your REAL columns and data rules.
ENABLED_METRICS=
METRIC_SCHEMA_NOTES=
# Example for the TEST FIXTURE ONLY, not a presumed production schema:
# ENABLED_METRICS=revenue,order_count,average_order_value,gross_margin,revenue_growth,five_year_trend
# METRIC_SCHEMA_NOTES=orders has one row per order, order_id primary key, customer_id, sold_at date, status, net_revenue after discounts/refunds excluding tax, historical_cogs. Exclude status cancelled. order_items is line grain linked by order_id; do not duplicate order-level amounts. Costs are historical at sale. Fixture history covers 2021 through 2025.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://127.0.0.1:3000
# Stable random secret for signed browser session cookies. Empty generates one per process.
SESSION_SECRET=
# Set true for HTTPS, particularly when frontend and backend are cross-site.
SESSION_SECURE=false
SQL_TIMEOUT_MS=5000
MAX_SQL_REPAIRS=2
QUERY_DEFAULT_ROWS=50
QUERY_MAX_ROWS=100
SCHEMA_CACHE_TTL_SECONDS=3600
MODEL_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=90
CONVERSATION_LIMIT=200
